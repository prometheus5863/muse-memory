# Provider chain in priority order. Providers without a key are skipped (ollama needs none).
MUSE_PROVIDERS=anthropic,openai,gemini,groq,ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Per-provider overrides: MUSE_<NAME>_MODEL, MUSE_<NAME>_BASE_URL, MUSE_<NAME>_TIMEOUT
# MUSE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
MUSE_OLLAMA_TIMEOUT=120
# Retry/backoff
MUSE_MAX_RETRIES=2
MUSE_BACKOFF_BASE=0.5
MUSE_BACKOFF_CAP=8
MUSE_TIMEOUT=30
# Memory
MUSE_DB=muse.db
MUSE_EMBEDDER=auto            # auto | ollama | st
# MUSE_EDGE_THRESHOLD=0.70
